# Database configuration (PostgreSQL with psycopg v3)
# Format: postgresql+psycopg://username:password@localhost:5432/dbname
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mine_subsidence
TEST_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/mine_subsidence_test

# Seed manager parameters
SEED_COMPANY_NAME=CHANGE_ME
SEED_MANAGER_USERNAME=CHANGE_ME
SEED_MANAGER_PASSWORD=CHANGE_ME
SEED_MANAGER_FULL_NAME=CHANGE_ME

# Auth and session security
# JWT_SECRET must be at least 32 characters long
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_RANDOM_SECRET_AT_LEAST_32_CHARS
SESSION_HOURS=8
COOKIE_SECURE=false
CORS_ORIGINS=

# Feature flags
ENABLE_DEMO_ROUTES=true

# Telemetry and offline timeout
OFFLINE_AFTER_S=35

# Gateway ingest authentication (Phase B)
ALLOW_UNKEYED_INGEST=false
# DEMO_GATEWAY_KEY must be at least 32 characters long
DEMO_GATEWAY_KEY=CHANGE_ME_GENERATE_A_DEMO_GATEWAY_KEY_32_CHARS

# Worker shift and work hours configuration (Step 5)
WEEKLY_HOURS_LIMIT=48
MAX_SHIFT_HOURS=16
HOURS_TIMEZONE=Asia/Kolkata

# Badge, Check-in, Headcount, and Check Flags configuration (Step 6)
CHECKOUT_GRACE_MIN=15
CHECKIN_EARLY_MIN=120
CHECK_FLAG_OVERDUE_HOURS=8
SCAN_RATE_PER_MIN=60

# Incident roll call, node commands, and siren configuration (Step 7)
COMMAND_TTL_S=120
SIREN_REFRESH_S=30
COMMANDS_REQUIRE_HTTPS=true
TRUST_FORWARDED_PROTO=false
COMMAND_RETENTION_DAYS=30
AUTO_INCIDENT_SIREN=true

# Worker reports and device SOS configuration (Step 8)
SOS_MERGE_WINDOW_S=60
SOS_MAX_NEW_PER_HOUR=6
SOS_INCIDENT_SIREN=false
REPORT_RATE_PER_HOUR=20
REPORT_MAX_AGE_DAYS_WORKER_VIEW=90

# Mine profile and output tracking configuration (Step 9)
SHIFT_LOOKAHEAD_H=12

# Alert notifications and outbox configuration (Step 10)
NOTIFICATIONS_ENABLED=true
TELEGRAM_BOT_TOKEN=your_telegram_token

TWILIO_ACCOUNT_SID=CHANGE_ME_TWILIO_ACCOUNT_SID
TWILIO_AUTH_TOKEN=CHANGE_ME_TWILIO_AUTH_TOKEN
TWILIO_WHATSAPP_FROM=CHANGE_ME_TWILIO_WHATSAPP_FROM

WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_SIGNING_SECRET_32_CHARS
NOTIFY_MAX_ATTEMPTS=5
NOTIFY_BACKOFF_BASE_S=10
NOTIFY_HTTP_TIMEOUT_S=5
NOTIFY_LOG_RETENTION_DAYS=30
DASHBOARD_BASE_URL=https://CHANGE_ME_DASHBOARD_DOMAIN
NOTIFY_ALLOW_HTTP_WEBHOOK=false
